{
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/",
      "destination": "/SidePanel.html"
    },
    {
      "source": "/side-panel",
      "destination": "/SidePanel.html"
    },
    {
      "source": "/main-stage",
      "destination": "/MainStage.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors https://meet.google.com https://*.meet.google.com;"
        }
      ]
    }
  ]
}
